# Copy to .env and edit. Read by the web and core containers.

# Web: a long random string, e.g. from `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`.
DJANGO_SECRET_KEY=change-me
# Host names the map is served under, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) when the admin is used behind HTTPS or another port, e.g. https://mlat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Admin login, created on first start.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too

# Optional map start view "lat,lon,zoom"; by default the map fits the receivers.
MLAT_MAP_START=
# Base map tiles.
MLAT_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Host ports.
HTTP_PORT=8080
# Receiver feed (TCP and UDP) and SBS output of MLAT fixes.
MLAT_FEED_PORT=31090
MLAT_SBS_PORT=31003
# Core config for plain Beast receivers (optional), inside ./config.
MLAT_CONFIG=/config/mlat.toml
